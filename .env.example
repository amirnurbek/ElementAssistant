# Copy to .env.local and fill in. Never commit real keys.
# Both keys are read only in server-side route handlers.
# Demo mode (/demo) works without any keys.
GEMINI_API_KEY=
# Optional: Gemini model id (default: gemini-3.8-flash)
GEMINI_MODEL=
ELEVENLABS_API_KEY=
# Optional. The default voice is retired by ElevenLabs on 2026-12-31: set your own.
ELEVENLABS_VOICE_ID=
# Optional (default: eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=
# Optional: where cached audio is stored (default: .cache/tts). Use /tmp/... on serverless.
TTS_CACHE_DIR=

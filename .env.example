# Copy this file to .env.local and fill in what you need. Never commit real keys.
# All keys are read only on the server (route handlers), never in the browser.
# Every variable is optional: without any of them, the demo games (/demo) work fully.

# --- Gemini: AI game generator (/create) ---
# Empty: /create shows "Game generation isn't set up yet" and links to the demo games.
GEMINI_API_KEY=
# Model id. Default: gemini-3.8-flash
GEMINI_MODEL=

# --- ElevenLabs: read-aloud button in classroom mode ---
# Empty: the read-aloud button is hidden.
ELEVENLABS_API_KEY=
# Voice id. ElevenLabs retires its default voices on 2026-12-31, so set one from your account.
ELEVENLABS_VOICE_ID=
# Model id. Default: eleven_multilingual_v2
ELEVENLABS_MODEL_ID=
# Where cached audio (<hash>.mp3) is stored. Default: .cache/tts
# On serverless hosts use a writable folder such as /tmp/tts.
TTS_CACHE_DIR=
